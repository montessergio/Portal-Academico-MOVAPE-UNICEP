<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Maestro MOVAPE / UNICEP</title>
    <style>
        :root {
            --primary-green: #2d5a27;
            --accent-blue: #5d93b1;
            --admin-purple: #4a4e69;
            --bg-gradient: linear-gradient(180deg, #98c1d9 0%, #7db9b6 100%);
            --card-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        body {
            margin: 0; font-family: 'Segoe UI', sans-serif;
            background: var(--bg-gradient); background-attachment: fixed;
            min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 20px 0;
        }

        .wrapper { width: 95%; max-width: 700px; }
        .card { background: white; border-radius: 25px; padding: 20px; margin-bottom: 15px; box-shadow: var(--card-shadow); border-top: 5px solid transparent; }
        .section-title { display: flex; align-items: center; gap: 10px; color: var(--primary-green); font-weight: bold; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 8px; }
        
        /* LOGIN ESPECÍFICO */
        .login-card { background: rgba(248, 250, 249, 0.95); padding: 30px; border-radius: 35px; text-align: center; }
        .demo-table { background: rgba(255,255,255,0.8); padding: 15px; border-radius: 20px; font-size: 0.8rem; margin-top: 20px; width: 100%; box-sizing: border-box; }
        .demo-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(0,0,0,0.05); }
        .demo-row b { color: #457b9d; cursor: pointer; text-decoration: underline; }

        /* BOTONES Y INPUTS */
        .btn-portal { width: 100%; padding: 12px; border: none; border-radius: 12px; background: linear-gradient(to right, #87b38d, #6b8e23); color: white; font-size: 1rem; font-weight: bold; cursor: pointer; }
        .btn-action { background: var(--accent-blue); color: white; border: none; padding: 6px 12px; border-radius: 8px; cursor: pointer; }
        .btn-danger { background: #e63946; color: white; border: none; padding: 5px 12px; border-radius: 8px; cursor: pointer; }
        input, select { width: 100%; padding: 10px; margin: 5px 0 15px 0; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; }

        /* VISTA PLAN COMPLETO */
        .full-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: white; z-index: 2000; overflow-y: auto; padding: 20px 0; }
        .plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; padding: 20px; }
        .cuatri-card { border: 1px solid #eee; padding: 12px; border-radius: 15px; background: #fafafa; border-top: 4px solid var(--primary-green); }
        .cuatri-card h4 { margin: 0 0 8px 0; color: var(--primary-green); font-size: 0.8rem; text-align: center; background: #e8f5e9; padding: 4px; border-radius: 5px; }
        .cuatri-card ul { list-style: none; padding: 0; margin: 0; font-size: 0.7rem; color: #444; }
        .cuatri-card li { padding: 3px 0; border-bottom: 1px dashed #ddd; }
    </style>
</head>
<body>

    <div id="loginView" class="wrapper">
        <div class="card" style="text-align: center; border: none;">
            <h1 style="color: var(--primary-green); margin: 0;">Fundación MOVAPE / UNICEP</h1>
            <p>Portal Universitario Digital</p>
        </div>
        <div class="login-card">
            <h3 style="color: var(--primary-green);">🎓 Acceso Seguro</h3>
            <form id="loginForm">
                <div style="text-align:left;"><label>ID Usuario:</label></div>
                <input type="text" id="uId" placeholder="Ingresa tu ID" required>
                <button type="submit" class="btn-portal">Ingresar al Portal</button>
            </form>
        </div>
        <div class="demo-table">
            <p style="text-align:center; font-weight:bold; margin-bottom:10px;">Cuentas de Acceso Rápido</p>
            <div class="demo-row"><span>Administrador (Root):</span> <b onclick="fill('ADMIN-01')">ADMIN-01</b></div>
            <div class="demo-row"><span>Ing. Industrial (1°):</span> <b onclick="fill('EST-001')">EST-001</b></div>
            <div class="demo-row"><span>Derecho (2°):</span> <b onclick="fill('EST-002')">EST-002</b></div>
            <div class="demo-row"><span>Psicología (3°):</span> <b onclick="fill('EST-003')">EST-003</b></div>
            <div class="demo-row"><span>Administración (4°):</span> <b onclick="fill('EST-004')">EST-004</b></div>
            <div class="demo-row"><span>Pedagogía (1°):</span> <b onclick="fill('EST-005')">EST-005</b></div>
            <div class="demo-row"><span>Docente Titular:</span> <b onclick="fill('PROF-101')">PROF-101</b></div>
        </div>
    </div>

    <div id="dashboardView" class="wrapper" style="display:none;">
        <div class="card" style="text-align: center; border-top-color: var(--primary-green);">
            <h2 id="welcomeText" style="margin:0;"></h2>
            <p id="accessTag" style="font-weight:bold; color:var(--accent-blue); font-size:0.9rem; margin:5px 0;"></p>
            <button class="btn-danger" style="font-size:0.7rem;" onclick="location.reload()">Cerrar Sesión</button>
        </div>
        <div id="dynamicContent"></div>
    </div>

    <div id="fullModal" class="full-modal">
        <div style="width:90%; max-width:1100px; margin:auto;">
            <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom:20px;">
                <h2 id="modalTitle" style="color:var(--primary-green);"></h2>
                <button class="btn-danger" onclick="closeModal()">Regresar</button>
            </div>
            <div id="modalBody"></div>
        </div>
    </div>

    <script>
        // --- BASE DE DATOS MAESTRA CON PLANES COMPLETOS ---
        const planesCompletos = {
            "INGENIERÍA INDUSTRIAL": [
                {c:"1°", m:["Introducción a la Ingeniería","Cálculo Integral","Lectura","Problemática Nacional"]},
                {c:"2°", m:["Innovación","Estadística Descriptiva","Álgebra Lineal","Liderazgo"]},
                {c:"3°", m:["Investigación Científica","Estadística Inferencial","Cálculo Vectorial","Sustentabilidad"]},
                {c:"4°", m:["Ingeniería Económica I","Planeación","Dibujo Industrial","Seguridad"]},
                {c:"5°", m:["Ergonomía","Metrología","Electricidad","Estudio del Trabajo I"]},
                {c:"6°", m:["Estudio del Trabajo II","Op. de Investigación I","Costos","Calidad"]},
                {c:"7°", m:["Op. de Investigación II","Mantenimiento","Mercadotecnia","Admón. de Operaciones I"]},
                {c:"8°", m:["Admón. de Operaciones II","Manufactura","Logística","Gestión de Calidad"]},
                {c:"9°", m:["Evaluación de Proyectos","Simulación","Relaciones Industriales","Seminario de Tesis"]}
            ],
            "DERECHO": [
                {c:"1°", m:["Estudio del Derecho","Teoría Económica","Derecho Romano","Derecho Civil"]},
                {c:"2°", m:["Teoría Política","Derecho Penal I","Argumentación","Derecho Civil II"]},
                {c:"3°", m:["Derechos Humanos","Obligaciones Civiles","Delitos","Teoría del Proceso"]},
                {c:"4°", m:["Derecho Constitucional","Laboral Individual","Sucesiones","Mercantil I"]},
                {c:"5°", m:["Procesal Penal","Filosofía","Laboral Colectivo","Juicio de Amparo I"]},
                {c:"6°", m:["Créditos","Procesal Civil","Internacional Público","Práctica de Amparo"]},
                {c:"7°", m:["Administrativo","Contratos Mercantiles","Procesal Constitucional","Comercio"]},
                {c:"8°", m:["Bancario","Propiedad Intelectual","Forense Civil","Derecho Fiscal I"]},
                {c:"9°", m:["Derecho Comparado","Seguridad Social","Mediación","Procesal Fiscal"]},
                {c:"10°", m:["Juicios Orales","Ética Profesional","Notarial","Electoral"]}
            ],
            "PSICOLOGÍA": [
                {c:"1°", m:["Bases Biológicas","Antropología","Neuroanatomía","Metodología I"]},
                {c:"2°", m:["Sensopercepción","Aprendizaje","Neurofisiología","Metodología II"]},
                {c:"3°", m:["Psicopatología I","Personalidad I","Estadística","Desarrollo Infantil"]},
                {c:"4°", m:["Psicodiagnóstico","Psicología Clínica","Educativa","Psicometría I"]},
                {c:"5°", m:["Psicometría II","Adolescencia","Entrevista","Recursos Humanos I"]},
                {c:"6°", m:["Ética","Trastornos","Educación Especial","Recursos Humanos II"]},
                {c:"7°", m:["Psicopatología Infantil","Grupos","Evaluación Personalidad","Ergonomía"]},
                {c:"8°", m:["Psicoanálisis","Terapia Familiar","Cognitiva","Tanatología"]},
                {c:"9°", m:["Seminario Clínica","Adicciones","Psicofarmacología","Tesis"]}
            ],
            "ADMINISTRACIÓN": [
                {c:"1°", m:["Admón I","Teoría Conocimiento","Contabilidad Básica","Realidad Nacional"]},
                {c:"2°", m:["Microeconomía","Metodología","Estadística","Proceso Admón"]},
                {c:"3°", m:["Liderazgo","Macroeconomía","Mercadotecnia I","Técnicas Inv."]},
                {c:"4°", m:["Mate Financiera","Comportamiento","Costos","Capital Humano"]},
                {c:"5°", m:["Planeación","Investigación Op.","Calidad","Derecho Laboral"]},
                {c:"6°", m:["Habilidades Directivas","Finanzas","Comercialización","Comunicación"]},
                {c:"7°", m:["Auditoría","Consultoría","Derecho Fiscal","Negociación"]},
                {c:"8°", m:["E-commerce","Desarrollo Org.","PyMES","Logística"]},
                {c:"9°", m:["Plan de Negocios","Ética","Mercantil","Estratégica"]}
            ],
            "PEDAGOGÍA": [
                {c:"1°", m:["Investigación I","Filosofía","Psicología Ed.","Teoría Pedagógica"]},
                {c:"2°", m:["Sociología","Historia Ed.","Infancia","Teorías Aprendizaje"]},
                {c:"3°", m:["Política","Clásica","Adolescencia","Estadística Aplicada"]},
                {c:"4°", m:["Didáctica","Comparada","Economía Ed.","Sistema Nacional"]},
                {c:"5°", m:["Andragogía","Docencia","Legislación","Capacitación"]},
                {c:"6°", m:["Planeación","Psicopedagogía","Diseño Curricular","Organismos"]},
                {c:"7°", m:["Evaluación","Social","Orientación","Epistemología"]},
                {c:"8°", m:["Competencias","Proyectos","Comunicación","Estrategias"]},
                {c:"9°", m:["Valores","Aprendizaje","Gestión","Didáctica II"]},
                {c:"10°", m:["Multiculturalidad","Tesis","Deontología","Distancia"]}
            ]
        };

        let db = {
            usuarios: {
                'ADMIN-01': { nombre: 'Ing. Roberto Silva', rol: 'admin', nivel: 'Control Maestro (Root)' },
                'EST-001': { nombre: 'María González', carrera: 'INGENIERÍA INDUSTRIAL', cuatri: '1°', mod: 'Sábados', rol: 'student', status: 'Activo' },
                'EST-002': { nombre: 'Isabella R.', carrera: 'DERECHO', cuatri: '2°', mod: 'Sábados', rol: 'student', status: 'Activo' },
                'EST-003': { nombre: 'Ana Sofía', carrera: 'PSICOLOGÍA', cuatri: '3°', mod: 'Domingos', rol: 'student', status: 'Activo' },
                'EST-004': { nombre: 'Carlos Ruiz', carrera: 'ADMINISTRACIÓN', cuatri: '4°', mod: 'Sábados', rol: 'student', status: 'Activo' },
                'EST-005': { nombre: 'Diego Pérez', carrera: 'PEDAGOGÍA', cuatri: '1°', mod: 'Domingos', rol: 'student', status: 'Activo' },
                'PROF-101': { nombre: 'Dr. Armando Paredes', rol: 'professor', materias: ['Cálculo Integral', 'Derecho Romano', 'Neuroanatomía'] }
            },
            archivos: [{ mat: 'Cálculo Integral', nombre: 'Guia_Examen_P1.pdf' }]
        };

        let sesion = null;

        function fill(id) { document.getElementById('uId').value = id; }

        document.getElementById('loginForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const id = document.getElementById('uId').value.toUpperCase();
            if (db.usuarios[id]) {
                sesion = { ...db.usuarios[id], id: id };
                renderApp();
            } else alert("Usuario no encontrado");
        });

        function renderApp() {
            document.getElementById('loginView').style.display = 'none';
            document.getElementById('dashboardView').style.display = 'block';
            document.getElementById('welcomeText').innerText = `Hola, ${sesion.nombre}`;
            document.getElementById('accessTag').innerText = sesion.rol.toUpperCase();
            
            const cont = document.getElementById('dynamicContent');
            cont.innerHTML = "";

            if (sesion.rol === 'admin') renderAdmin(cont);
            else if (sesion.rol === 'professor') renderProfessor(cont);
            else renderStudent(cont);
        }

        // --- RENDER ESTUDIANTE (VISTA COMPLETA) ---
        function renderStudent(cont) {
            if(sesion.status === 'Baja') {
                cont.innerHTML = `<div class="card" style="border-top-color:red; text-align:center;"><h2 style="color:red;">ESTATUS: BAJA</h2><p>Acceso restringido por la administración.</p></div>`;
                return;
            }
            const mallas = planesCompletos[sesion.carrera];
            const misMat = mallas[parseInt(sesion.cuatri)-1].m;
            const misFiles = db.archivos.filter(f => misMat.includes(f.mat));

            cont.innerHTML = `
                <div class="card" style="border-top-color: var(--accent-blue);">
                    <div class="section-title">👤 Mis Datos</div>
                    <p style="font-size:0.9rem;"><b>Carrera:</b> ${sesion.carrera}<br><b>Cuatri:</b> ${sesion.cuatri} | <b>Modalidad:</b> ${sesion.mod}</p>
                </div>
                <div class="card">
                    <div class="section-title">📊 Calificaciones Actuales</div>
                    ${misMat.map(m => `<div class="demo-row"><span>${m}</span><b>9.5</b></div>`).join('')}
                </div>
                <div class="card">
                    <div class="section-title">📁 Material del Docente</div>
                    ${misFiles.length > 0 ? misFiles.map(f => `<div class="demo-row"><span>${f.mat} - ${f.nombre}</span><button class="btn-action">Bajar</button></div>`).join('') : '<p style="text-align:center; color:#999; font-size:0.8rem;">Sin materiales subidos.</p>'}
                </div>
                <div class="card" style="border:2px solid var(--primary-green); cursor:pointer;" onclick="openFullPlan('${sesion.carrera}')">
                    <div class="section-title" style="border:none; margin:0; justify-content:center;">📋 VER PLAN DE ESTUDIOS COMPLETO</div>
                </div>`;
        }

        // --- RENDER DOCENTE ---
        function renderProfessor(cont) {
            cont.innerHTML = `
                <div class="card">
                    <div class="section-title">👨‍🏫 Mis Materias</div>
                    ${sesion.materias.map(m => `<div class="demo-row"><span>${m}</span><button class="btn-action" onclick="alert('Lista de asistencia abierta para ${m}')">Lista</button></div>`).join('')}
                </div>
                <div class="card">
                    <div class="section-title">📁 Subir Archivos Académicos</div>
                    <select id="selMat">${sesion.materias.map(m=>`<option>${m}</option>`)}</select>
                    <input type="file" id="upInp">
                    <button class="btn-portal" onclick="subirMaterial()">Publicar Material</button>
                </div>`;
        }

        function subirMaterial() {
            const file = document.getElementById('upInp').files[0];
            if(!file) return alert("Selecciona un archivo");
            db.archivos.push({ mat: document.getElementById('selMat').value, nombre: file.name });
            alert(`Archivo "${file.name}" compartido con los alumnos.`);
        }

        // --- RENDER ADMIN ---
        function renderAdmin(cont) {
            cont.innerHTML = `
                <div class="card" style="border-top-color: var(--admin-purple);">
                    <div class="section-title">🛡️ Panel Administrador</div>
                    <p style="font-size:0.8rem;">Responsable: <b>${sesion.nombre}</b></p>
                </div>
                <div class="card" onclick="adminUsers()">
                    <div class="section-title">👥 Gestión de Usuarios</div>
                    <p style="font-size:0.75rem; color:#666;">Modificar estatus, carreras o asignar materias.</p>
                </div>
                <div class="card" onclick="adminPlanes()">
                    <div class="section-title">⚙️ Configuración Académica</div>
                    <p style="font-size:0.75rem; color:#666;">Editar materias en planes de estudio oficiales.</p>
                </div>`;
        }

        function adminUsers() {
            openModal("Gestión de Usuarios");
            const b = document.getElementById('modalBody');
            b.innerHTML = `<div id="admEst"></div><hr><div id="admProf"></div>`;
            Object.keys(db.usuarios).forEach(id => {
                const u = db.usuarios[id];
                if(u.rol === 'student') {
                    document.getElementById('admEst').innerHTML += `
                    <div class="card" style="font-size:0.8rem; border:1px solid #eee;">
                        <b>${u.nombre} (${id})</b><br>
                        Carrera: <select onchange="db.usuarios['${id}'].carrera=this.value; alert('Cambio por ${sesion.nombre}')">
                            ${Object.keys(planesCompletos).map(p => `<option ${u.carrera===p?'selected':''}>${p}</option>`)}
                        </select>
                        Status: <button class="btn-action ${u.status==='Baja'?'btn-danger':''}" onclick="db.usuarios['${id}'].status=(db.usuarios['${id}'].status==='Activo'?'Baja':'Activo'); adminUsers();">${u.status}</button>
                    </div>`;
                } else if(u.rol === 'professor') {
                    document.getElementById('admProf').innerHTML += `
                    <div class="card" style="font-size:0.8rem; border:1px solid #eee;">
                        <b>${u.nombre}</b><br>Asignaturas: ${u.materias.join(', ')}<br>
                        <button class="btn-action" style="margin-top:5px;" onclick="const n=prompt('Nueva materia:'); if(n){db.usuarios['${id}'].materias.push(n); adminUsers();}">+ Asignar</button>
                    </div>`;
                }
            });
        }

        function adminPlanes() {
            openModal("Mallas Curriculares");
            const b = document.getElementById('modalBody');
            Object.keys(planesCompletos).forEach(c => {
                b.innerHTML += `<div class="card"><b>${c}</b><br><button class="btn-action" onclick="openFullPlan('${c}')">Ver / Editar Materias</button></div>`;
            });
        }

        // --- FUNCIONES DE MODAL ---
        function openFullPlan(carrera) {
            openModal(`Plan de Estudios: ${carrera}`);
            const grid = document.createElement('div');
            grid.className = 'plan-grid';
            planesCompletos[carrera].forEach(q => {
                grid.innerHTML += `
                    <div class="cuatri-card">
                        <h4>${q.c} Cuatrimestre</h4>
                        <ul>${q.m.map(m => `<li>${m}</li>`).join('')}</ul>
                    </div>`;
            });
            document.getElementById('modalBody').appendChild(grid);
        }

        function openModal(title) {
            document.getElementById('fullModal').style.display = 'block';
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalBody').innerHTML = "";
        }
        function closeModal() { document.getElementById('fullModal').style.display = 'none'; }
    </script>
</body>
</html>
